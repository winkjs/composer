{
    "name": "@winkjs/composer",
    "version": "0.5.0",
    "description": "Composable Streaming Intelligence — turn streaming data into actionable insights, from edge to cloud",
    "keywords": [
        "streaming",
        "streaming-intelligence",
        "streaming-analytics",
        "real-time",
        "edge-computing",
        "iot",
        "iiot",
        "industrial-iot",
        "time-series",
        "signal-processing",
        "anomaly-detection",
        "predictive-maintenance",
        "mqtt",
        "questdb",
        "winkjs",
        "wink"
    ],
    "main": "src/composer.js",
    "module": "src/composer.js",
    "exports": {
        ".": "./src/composer.js"
    },
    "scripts": {
        "pretest": "npm run lint",
        "test": "mocha --recursive \"src/**/*.specs.js\" --ignore \"src/**/slow-*.specs.js\"",
        "test:hardening": "node --expose-gc node_modules/mocha/bin/mocha.js --recursive \"src/**/slow-*.specs.js\" --timeout 300000 --exit",
        "test:coverage": "c8 --reporter=html mocha --recursive \"src/**/*.specs.js\" --ignore \"src/**/slow-*.specs.js\"",
        "lint": "eslint \"src/**/*.js\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/winkjs/composer.git"
    },
    "author": "Sanjaya Kumar Saxena",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "src/composer.js",
        "src/core/**/*.js",
        "src/flow/**/*.js",
        "src/nodes/**/*.js",
        "src/tools/**/*.js",
        "src/windowing/**/*.js",
        "!src/**/*.specs.js",
        "!src/**/test/",
        "!src/core/emitter-manager/mqtt/mqtt-store.js"
    ],
    "bugs": {
        "url": "https://github.com/winkjs/composer/issues"
    },
    "homepage": "https://composer.winkjs.org/",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "c8": "^10.1.3",
        "chai": "^5.2.0",
        "classic-level": "^3.0.0",
        "eslint": "^9.21.0",
        "eslint-plugin-security": "^4.0.0",
        "mocha": "^11.1.0",
        "sinon": "^19.0.2"
    },
    "dependencies": {
        "@questdb/nodejs-client": "^4.2.0",
        "glob": "^13.0.6",
        "mqtt": "^5.15.1",
        "msgpackr": "^1.11.10",
        "pg": "^8.20.0"
    },
    "overrides": {
        "serialize-javascript": "^7.1.0",
        "diff": "^8.0.3"
    }
}
