# Logs
logs
*.log
npm-debug.log*

# Node diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Dependency directories
node_modules/

# Coverage output (c8 / nyc / coveralls)
coverage
*.lcov
.nyc_output

# ESLint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# macOS
.DS_Store

# Example and feasibility-study run outputs
src/examples/**/out/

# Benchmark raw results (per-machine, not for version control)
benchmark/*/results/

# Claude Code scratchpad (working drafts, not for version control)
.scratchpad/

# Claude Code config — local to each developer's machine, never shipped
.claude/

# Browser-test screenshots
.playwright-screenshots/

# Playwright MCP session artifacts (page snapshots, console logs)
.playwright-mcp/
